GOOGLE_API_KEY=your_google_ai_studio_key
GEMINI_API_KEY=your_google_ai_studio_key
# Primary chat model — see https://ai.google.dev/gemini-api/docs (gemini-3.1-flash-lite-preview)
GOOGLE_MODEL_NAME=gemini-3.1-flash-lite-preview
# Default 12288 — raises headroom for richer visuals and longer tool payloads.
# GOOGLE_MAX_OUTPUT_TOKENS=12288
# Thinking level for Gemini responses via pydantic_ai + google-genai.
# Supported levels are minimal|low|medium|high; legacy xhigh is normalized to high.
# GOOGLE_THINKING_LEVEL=high
# Reserve output budget in limiter; keep aligned with max output tokens.
# GOOGLE_RESERVED_OUTPUT_TOKENS=12288
# Optional generic fallback if the primary model returns transient 5xx responses
GOOGLE_FALLBACK_MODEL_NAME=gemini-3.1-pro-preview
# Recommended stronger model for visual-only recovery / fallback generation
GOOGLE_VISUAL_RECOVERY_MODEL_NAME=gemini-3.1-pro-preview
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
# Optional: when set on the backend, send the same value from the frontend:
# CHAT_API_KEY=your-long-random-secret
# VITE_CHAT_API_KEY=your-long-random-secret
# SQLite conversation store (default: <repo>/data/conversations.db)
# DATABASE_PATH=
# Optional: inline full docs/skill/*.md content into both compiled prompts at service startup.
# AGENT_LOAD_FULL_SKILL_DOCS_ON_SESSION_START=false
